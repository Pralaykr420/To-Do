# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/todo-app?retryWrites=true&w=majority

# Port the Express server will run on
PORT=5000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth Client ID -- from Google Cloud Console (see README "Google OAuth setup")
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID

# Secret used to sign app JWTs -- use a long random string, e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
